{$SITE_DOMAIN} {
	encode gzip

	handle_path /static/* {
		root * /srv/static
		file_server
	}

	handle {
		reverse_proxy web:8000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
	}
}
