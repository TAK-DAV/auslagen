# Copy this file to .env and replace every change-me / placeholder.
# Docker Compose reads .env. Do not commit .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=auslagen
POSTGRES_USER=auslagen
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

SITE_URL=http://localhost:8000
# Production (docker-compose.prod.yml + Caddy): set SITE_DOMAIN to the bare hostname.
SITE_DOMAIN=localhost

DEFAULT_FROM_EMAIL=auslagen@example.org
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# Production (do not use DEBUG=1 on the server):
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=auslagen.service.dav-tak.de
# CSRF_TRUSTED_ORIGINS=https://auslagen.service.dav-tak.de
# SITE_URL=https://auslagen.service.dav-tak.de
# SITE_DOMAIN=auslagen.service.dav-tak.de
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
