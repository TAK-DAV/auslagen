# Copy this file to .env and replace both change-me values.
# Docker Compose reads .env. Do not commit .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=auslagen
POSTGRES_USER=auslagen
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

SITE_URL=http://localhost:8000
DEFAULT_FROM_EMAIL=auslagen@example.org
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
